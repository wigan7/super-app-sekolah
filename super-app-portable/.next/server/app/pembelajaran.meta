{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/pembelajaran/layout,_N_T_/pembelajaran/page,_N_T_/pembelajaran"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/pembelajaran/__PAGE__",
    "/pembelajaran",
    "/_index",
    "/_head"
  ]
}